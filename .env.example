# ---- Web Push -------------------------------------------------------------
# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Poller -----------------------------------------------------------------
# cron-job.org sends this as "Authorization: Bearer <CRON_SECRET>" to /api/poll.
# Any long random string, e.g.  openssl rand -hex 32
CRON_SECRET=

# ---- Access -----------------------------------------------------------------
# Passcode that protects your follows, devices and settings (no accounts).
# Use something long; it is entered once per device.
APP_PASSCODE=

# ---- Storage ----------------------------------------------------------------
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Without them the app uses an in-memory store (local development only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
